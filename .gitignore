# Local media and working data (very large). Keep directory placeholders.
data/raw/**
!data/raw/.gitkeep
data/ground_truth/**
!data/ground_truth/.gitkeep
data/work/**
!data/work/.gitkeep
data/out/**
!data/out/.gitkeep

# Large audio / archives (never commit)
*.flac
*.wav
*.aiff
*.aif
*.alac
*.mp3
*.m4a
*.ogg
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Secrets
.env
.env.*
!.env.example

# Download / runtime logs (may contain huge curl progress spam)
logs/
!logs/.gitkeep
